run = "PORT=5000 node scripts/run-replit.mjs"

modules = ["python-3.12", "web", "nodejs-22"]

[packager.features]
enabledForHosting = false

[env]
PIP_TARGET = ".pythonlibs"
PIP_USER = "false"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "PORT=5000 node scripts/run-replit.mjs"]
build = ["bash", "-c", "PIP_USER=false python -m pip install --upgrade --target .pythonlibs -r requirements.txt && pnpm --dir frontend install --frozen-lockfile"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node scripts/run-replit.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
PIP_TARGET = ".pythonlibs"
