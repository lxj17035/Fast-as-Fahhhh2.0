# Copy this file to .env and fill in your own private values there.
# Never put real API keys, passwords, tokens, or webhook secrets in this file.
# .env is ignored by Git; .env.example is safe to share.

# Xinjie quotation backend: blank AI values select manual draft fallback.
OPENAI_API_KEY=
OPENAI_MODEL=

# Non-secret local defaults.
QUOTATION_DB=data/quotation.sqlite3
PORT=8004

# Sweeway Telegram backend: enter your own PostgreSQL connection URL in .env.
# Include the database username/password only in your private .env.
DATABASE_URL=
# Set your own random private webhook secret in .env (A-Z, a-z, 0-9, _ or -).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=

# backend.server loads .env itself. app.main currently reads process environment;
# follow docs/TELEGRAM.md when launching the Telegram service.
# The two backends still use separate storage until their integration is done.
