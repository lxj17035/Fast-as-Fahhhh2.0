# Copy to .env locally. Never commit real credentials.
# Blank credentials select a clearly labelled manual draft fallback.
OPENAI_API_KEY=
# Set a model available to your account that supports structured outputs.
OPENAI_MODEL=
QUOTATION_DB=data/quotation.sqlite3
PORT=8004
# Reserved for Sweeway; this backend does not implement Telegram transport.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
