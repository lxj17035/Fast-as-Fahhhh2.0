# Copy this file to .env and fill in your own private values there.
# Never put real API keys, passwords, tokens, or webhook secrets in this file.
# .env is ignored by Git; .env.example is safe to share.

# Select runpod, openai, or manual. Blank keys select manual draft fallback.
AI_PROVIDER=runpod
RUNPOD_API_KEY=
# Public defaults from the event announcement; confirm in your Runpod console.
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2/b1dd8hy2hqo1nb/openai/v1
RUNPOD_MODEL=glm-5.3
RUNPOD_MAX_TOKENS=1024
RUNPOD_DAILY_REQUEST_LIMIT=100

# Optional alternative provider, used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Non-secret local default.
PORT=8004

# Shared database for quotation and Telegram modules; used locally and on Replit.
# Enter your own PostgreSQL connection URL in .env.
# Include the database username/password only in your private .env.
DATABASE_URL=
# Set your own random private webhook secret in .env (A-Z, a-z, 0-9, _ or -).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# Used only for Member 2's controlled live test; not required to start the backend.
# Enter the team-owned test chat ID privately. Never use a customer chat.
LIVE_TEST_CHAT_ID=

# Both backend.server and app.main load .env. Process environment takes precedence.
# SQLite is only an explicit test/offline-fixture adapter, never the runtime database.

# Enable simulated PM approval only for the supervised team demo.
ENABLE_DEMO_APPROVAL=false

# Docker Compose on Ubuntu only. Use a random hex password (URL-safe).
# Compose builds DATABASE_URL for its private db service; the local URL above is ignored.
POSTGRES_PASSWORD=
WEB_PORT=8080
