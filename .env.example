# Use one shared PostgreSQL database for the whole team.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/sweeway
# Generate a random value using only A-Z, a-z, 0-9, underscores and hyphens.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
# Needed when registering the bot or later sending documents; never commit it.
TELEGRAM_BOT_TOKEN=
